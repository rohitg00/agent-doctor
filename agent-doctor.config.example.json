{
  "profile": "local",
  "commands": {
    "typecheck": "npm run lint",
    "test": "npm test"
  },
  "risk": {
    "critical": [
      "src/auth/**",
      "src/payments/**",
      "db/migrations/**",
      ".env*"
    ],
    "generated": [
      "**/*.generated.*",
      "**/__generated__/**"
    ]
  },
  "skills": {
    "paths": [".codex/skills", ".agents/skills", ".claude/skills", ".cursor/rules"],
    "maxInlineBytes": 160000,
    "validationLayers": ["structure"]
  },
  "ci": {
    "annotations": false,
    "stickyComment": false
  }
}
